{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-local Renovate policy for the dishwasher card",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Zurich",
  "schedule": [
    "before 06:00 on monday"
  ],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security",
      "dependencies"
    ],
    "vulnerabilityFixStrategy": "lowest"
  },
  "packageRules": [
    {
      "description": "Automerge non-major vulnerability fixes after required checks pass",
      "matchJsonata": [
        "$exists(vulnerabilityFixVersion) and updateType != 'major'"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge GitHub Actions digest, pin, patch and minor updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch",
        "minor"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require Dependency Dashboard approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Automerge compatible Node.js development dependency updates",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-dev",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Treat Node.js runtime dependency updates as releasable fixes",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
